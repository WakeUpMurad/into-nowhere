# Server-only. Copy values into the hosting provider's secret settings.
# The Go server reads process environment variables, not this file automatically.
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
PAYMENT_MERCHANT_APPROVED=false
PAYMENT_CURRENCY_APPROVED=false
PAYMENT_CURRENCY=AZN
# Use the minimum and maximum expressly approved for your merchant account.
PAYMENT_MIN_AMOUNT_MINOR=
PAYMENT_MAX_AMOUNT_MINOR=
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_MERCHANT_NAME=
PAYMENT_SUPPORT_EMAIL=
# Requires a persistent filesystem and only one API process.
PAYMENT_DATA_PATH=data/payments.json
# Optional, explicit public bind behind an HTTPS proxy. Default stays loopback.
# LISTEN_ADDR=0.0.0.0:8080
PORT=8080
